# 
# 

# netweave-api
NODE_ENV=e2e.api
WEB_APP_URL=http://localhost:4200

# netweave-api auth
JWT_SECRET="jwt_secret_code"

# netweave-api mails (1)
SEND_MAIL_ACTIVATED=false
SEQUENTIAL_TEST_MAIL_RECEIVER=
SEQUENTIAL_TEST_MAIL_CRON_SCHEDULE=*/1 * * * *

# netweave-api mails (2)
# 
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Netweave
MAIL_FROM_ADDRESS=info@netweave.de

# netweave-db
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=netweave_e2e_api
DB_PASSWORD=netweave_e2e_password_api
DB_DB=netweave_e2e_api
