# Example environment variables for the Netweave projects
# Copy this file to `.env` at the root of the workspace and fill in real values.

# netweave-api
SEND_MAIL_ACTIVATED=true # true|false; whether the MailService should actually send mails or just log them to the console (should be true for any prod system)
MAIL_RECEIVER=test@test.test # email address that receives the mails sent by MailService if SEND_MAIL_ACTIVATED is true
NODE_ENV=production # "develop" | "production" | "e2e.api"; node.js environment
CRON_SCHEDULE_MAIL_SEND=*/1 * * * * # every minute by default; https://crontab.guru/
WEB_APP_URL=https://dev.netweave.de # base URL used to build links (e.g. the invitation link) inside emails

# netweave-api mail transport (Nodemailer/SMTP)
# these are only the *defaults*; an admin can override them at runtime from the
# Mail-Einstellungen admin page, which persists the override to the database
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true # true|false; whether to use TLS
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
MAIL_FROM_NAME=Netweave
MAIL_FROM_ADDRESS=info@netweave.de

# netweave-api auth
JWT_SECRET="long_random_string"

# netweave-db
DB_HOST=localhost # database host, needs to be 'netweave-db' when running in docker-compose
DB_USER=root
DB_PASSWORD=root
DB_DB=test
