# Example environment variables for the Netweave projects
# Copy this file to `.env` at the root of the workspace and fill in real values.

# netweave-api
NODE_ENV=production # "develop" | "production" | "e2e.api"; node.js environment
WEB_APP_URL=https://dev.netweave.de # base URL used to build links (e.g. the invitation link) inside emails

# netweave-api auth
JWT_SECRET="long_random_string"
# optional; comma separated emails / domains that may register in addition to the whitelist managed on the settings page
# each entry may carry a role (admin|editor|viewer) the user receives on registration, default is viewer
# e.g. REGISTRATION_WHITELIST="boss@example.com:admin,@example.com"
REGISTRATION_WHITELIST=

# netweave-api mails (1)
SEND_MAIL_ACTIVATED=true # true|false; whether Netweave should actually send mails (Nodemailer/SMTP) or just log them to the console (should be true for any prod system)
SEQUENTIAL_TEST_MAIL_RECEIVER=test@test.test # email address that receives dummy e-mails for testing purposes sent by SequentialTestMailerService (if SEND_MAIL_ACTIVATED is true)
SEQUENTIAL_TEST_MAIL_CRON_SCHEDULE=*/1 * * * * # every minute by default; https://crontab.guru/

# netweave-api mails (2)
# the settings below are only the *defaults*; an admin can override them at runtime from the Mail-Einstellungen admin page, which persists the override to the database
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true # true|false; whether to use TLS
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
MAIL_FROM_NAME=Netweave
MAIL_FROM_ADDRESS=info@netweave.de

# netweave-db
DB_HOST=localhost # database host, needs to be 'netweave-db' when running in docker-compose
DB_PORT=5433
DB_USER=root
DB_PASSWORD=root
DB_DB=test
