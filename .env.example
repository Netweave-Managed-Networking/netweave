# Example environment variables for the Netweave projects
# Copy this file to `.env` at the root of the workspace and fill in real values.
# 
# docker compose (server only, not read by the app)
INSTANCE_NAME=dev # unique name of this instance on the server; lowercase letters, digits and hyphens only; the proxy reaches its containers as <INSTANCE_NAME>-api and <INSTANCE_NAME>-web; also names its Compose project netweave-<INSTANCE_NAME> and its volumes, so never change it later, or the instance gets a new, empty database
IMAGE_TAG=develop # develop|main|<branch-name>; branch whose images this instance runs, used by docker-compose.yml
DB_PUBLISHED_PORT=5432 # server only; port on the server's 127.0.0.1 for reaching this instance's database through an SSH tunnel (e.g. DBeaver); must be unique per instance (e.g. 5432 dev, 5433 dummy); not to be confused with DB_PORT, which the api uses inside Docker and stays 5432
# 
# netweave-api
NODE_ENV=production # "develop" | "production" | "e2e.api"; node.js environment
WEB_APP_URL=https://dev.netweave.de # base URL used to build links (e.g. the invitation link) inside emails
# 
# netweave-db
DB_HOST=localhost # "localhost" for local development (database from docker-compose.local.yml); "db" on the server (the service name in docker-compose.yml)
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DB=test
SEED_ALLOWED=false # true allows the seed command `npm run db:seed` to wipe all members, invitations and matchings in this database and refill them from seed files; set true only locally and on instances meant for test data (e.g. dummy)
# 
# netweave-api auth
JWT_SECRET="long_random_string"
# optional; comma separated emails / domains that may register in addition to the whitelist managed on the settings page
# each entry may carry a role (admin|editor|viewer) the user receives on registration, default is viewer
# e.g. REGISTRATION_WHITELIST="boss@example.com:admin,@example.com"
REGISTRATION_WHITELIST=
# 
# netweave-api matching
MATCHING_COMPUTATION_CRON_SCHEDULE=0 0 * * 0 # once a week (Sunday midnight) by default; calculates the matching scores between all members; https://crontab.guru/
RANKING_STRATEGY=category-separation # category-separation|max-category; how the top 3 recommendations per member are ranked from the matching scores at the end of a run
SEND_RECOMMENDATION_MAILS=true # true (default)|false; whether every member gets a mail with its top 3 recommendations after each finished run (scheduled or started manually)
# 
# netweave-api members
MEMBER_UPDATE_REMINDER_INTERVAL=6 months # <n> minute(s)|hour(s)|day(s)|week(s)|month(s)|year(s), default 6 months; a member is mailed a link to check its data once its last update and last such mail are both this long ago
# 
# netweave-api matching llm
# the matching asks an llm how well the resources of a member cover the requirements of another, per category;
# that is up to n*(n-1)*6 llm calls per run for n members. leave LLM_PROVIDER empty to use the dummy string length matching instead
LLM_PROVIDER= # openai|anthropic|mistral|openai-compatible; openai-compatible works with any server speaking the openai chat api (e.g. ollama, vllm)
LLM_MODEL= # model id of the provider, e.g. mistral-small-latest
LLM_API_KEY= # api key of the provider; optional for local servers like ollama
LLM_BASE_URL= # required for openai-compatible (e.g. http://localhost:11434/v1), optional override for the others (e.g. a proxy or eu endpoint)
LLM_CONCURRENCY=5 # max parallel llm calls of a matching run; keep below the rate limit of your provider account
LLM_TIMEOUT_MS=60000 # per llm call, so a hanging request cannot stall a run
LLM_REASONING= # provider-default (default)|none|minimal|low|medium|high|xhigh; how much a reasoning model thinks before answering, "none" makes them much faster where supported
# 
# netweave-api mails (1)
SEND_MAIL_ACTIVATED=true # true|false; whether Netweave should actually send mails (Nodemailer/SMTP) or just log them to the console (should be true for any prod system)
SEQUENTIAL_TEST_MAIL_RECEIVER=test@test.test # email address that receives dummy e-mails for testing purposes sent by SequentialTestMailerService (if SEND_MAIL_ACTIVATED is true)
SEQUENTIAL_TEST_MAIL_CRON_SCHEDULE=*/1 * * * * # every minute by default; https://crontab.guru/
# 
# netweave-api mails (2)
# the settings below are only the *defaults*; an admin can override them at runtime from the Mail-Einstellungen admin page, which persists the override to the database
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true # true|false; whether to use TLS
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
MAIL_FROM_NAME=Netweave
MAIL_FROM_ADDRESS=info@netweave.de

