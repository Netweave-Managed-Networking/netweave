{
  "name": "netweave-api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["netweave-api"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/netweave-api-e2e"
      ],
      "dependsOn": ["netweave-api:build"],
      "options": {
        "passWithNoTests": true
      }
    }
  }
